# CAD text is UTF-8 without BOM and uses Windows line endings.
*.lsp text eol=crlf
*.LSP text eol=crlf
*.dcl text eol=crlf
*.scr text eol=crlf
*.mnl text eol=crlf
*.lin text eol=crlf
*.pat text eol=crlf

# Normal project text files.
*.cs text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.html text eol=crlf
*.py text eol=crlf
*.md text eol=crlf
.gitignore text eol=crlf
.gitattributes text eol=crlf
